{
  "name": "@clinic/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src && tsc --noEmit",
    "dev": "tsc --watch",
    "start": "node --env-file=../../.env dist/main.js",
    "worker": "node --env-file=../../.env dist/worker.js",
    "test": "npm run build && node ../../scripts/test-backend.mjs",
    "test:coverage": "npm run build && node ../../scripts/test-backend.mjs --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npm run build && node --env-file=../../.env dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.16.3",
    "pg-boss": "12.30.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "class-validator": "0.14.3",
    "class-transformer": "0.5.1",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "nodemailer": "7.0.11",
    "@aws-sdk/client-s3": "3.922.0",
    "file-type": "21.1.1",
    "sharp": "0.34.5",
    "luxon": "3.7.2",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "@types/express": "5.0.5",
    "@types/cookie-parser": "1.4.10",
    "@types/pg": "8.15.6",
    "@types/nodemailer": "7.0.4",
    "@types/multer": "2.0.0",
    "@types/luxon": "3.7.1"
  }
}
