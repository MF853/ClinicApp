{
  "name": "clinicapp",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @clinic/backend && npm run build -w @clinic/web",
    "lint": "npm run lint --workspaces",
    "test": "npm run test -w @clinic/backend",
    "test:e2e": "playwright test",
    "test:coverage": "npm run test:coverage -w @clinic/backend",
    "db:generate": "npm run db:generate -w @clinic/backend",
    "db:migrate": "npm run db:migrate -w @clinic/backend",
    "db:seed": "npm run db:seed -w @clinic/backend",
    "infra:up": "docker compose up -d --wait",
    "mobile:sync": "npm run mobile:sync -w @clinic/web",
    "db:test:prepare": "node scripts/test-db.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.11.1",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "c8": "10.1.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.0"
  }
}
